<?xml version="1.0" encoding="UTF-8"?>
<project default="clean" basedir="." name="redshift-jdbc-extension">
    <description>
        Build Amazon Redshift JDBC Extension (maven + OSGi)
    </description>

    <property name="temp" location="temp"/>
    <property name="dist" location="target"/>

    <scriptdef name="trim" language="javascript">
        <attribute name="text" />
        <attribute name="property" />
        <![CDATA[
            var text = attributes.get("text");
            project.setProperty(attributes.get("property"), text.trim());
        ]]>
    </scriptdef>

    <scriptdef name="first" language="javascript">
        <attribute name="text" />
        <attribute name="property" />
        <attribute name="default" />
        <![CDATA[
            var text = attributes.get("text").trim();
            var def = attributes.get("default");
            if (def && def.indexOf('${') == -1) text = def;
            var arr = text.split(/\s+/);
            project.setProperty(attributes.get("property"), arr[0]);
        ]]>
    </scriptdef>

    <scriptdef name="replace" language="javascript">
        <attribute name="haystack" />
        <attribute name="needle" />
        <attribute name="repl" />
        <attribute name="property" />
        <![CDATA[
            var text = attributes.get("haystack").trim();
            var regex = new RegExp(attributes.get("needle"), 'g');
            text = text.replace(regex, attributes.get("repl"));
            project.setProperty(attributes.get("property"), text);
        ]]>
    </scriptdef>

    <scriptdef name="unwrap" language="javascript">
        <attribute name="text" />
        <attribute name="property" />
        <![CDATA[
            var text = attributes.get("text").trim();
            if (text.startsWith('"') && text.endsWith('"')) text = text.substring(1, text.length() - 1);
            project.setProperty(attributes.get("property"), text);
        ]]>
    </scriptdef>

    <scriptdef name="getNameFrom" language="javascript">
        <attribute name="path" />
        <attribute name="property" />
        <![CDATA[
            var path = attributes.get("path");
            var index = path.lastIndexOf('/');
            if (index == -1) index = path.lastIndexOf('\\');
            project.setProperty(attributes.get("property"), path.substring(index + 1));
        ]]>
    </scriptdef>

    <macrodef name="loadmf">
        <attribute name="jar"/>
        <attribute name="prefix" default=""/>
        <sequential>
            <loadproperties>
                <zipentry zipfile="@{jar}" name="META-INF/MANIFEST.MF"/>
                <filterchain>
                    <prefixlines prefix="@{prefix}"/>
                </filterchain>
            </loadproperties>
        </sequential>
    </macrodef>

    <target name="init">
        <delete dir="${temp}"/>
        <delete dir="${dist}/extension"/>
        <mkdir dir="${temp}"/>
        <mkdir dir="${dist}/"/>
    </target>

    <target name="maven-build" depends="init">
        <!-- maven path: fetch the original AWS driver into a repository layout for the maven/ folder -->
        <exec dir="${basedir}" executable="mvn" failonerror="true">
            <arg value="-DoutputDirectory=${temp}/dependency"/>
            <arg value="-Dmdep.copyPom=true"/>
            <arg value="-Dmdep.useRepositoryLayout=true"/>
            <arg value="-DincludeGroupIds=${mvnGroupId}"/>
            <arg value="-DincludeArtifactIds=${mvnArtifactId}"/>
            <arg value="-DincludeVersion=${mvnVersion}"/>
            <arg value="dependency:copy-dependencies"/>
        </exec>
        <exec executable="bash" failonerror="true">
            <arg value="${basedir}/copy-parent-poms.sh"/>
            <arg value="${temp}/dependency"/>
        </exec>

        <!-- osgi path: fetch the OSGi-wrapped bundle for the jars/ folder -->
        <exec dir="${basedir}" executable="mvn" failonerror="true">
            <arg value="-DoutputDirectory=${temp}/osgi"/>
            <arg value="-DincludeGroupIds=org.lucee"/>
            <arg value="-DincludeArtifactIds=redshift"/>
            <arg value="-DincludeVersion=${osgiBundleVersion}"/>
            <arg value="dependency:copy-dependencies"/>
        </exec>
    </target>

    <target name="copy-dependencies" depends="maven-build">
        <!-- maven/ : the AWS driver + its pom(s), for Lucee's maven-based JDBC loading -->
        <mkdir dir="${dist}/extension/maven"/>
        <copy todir="${dist}/extension/maven">
            <fileset dir="${temp}/dependency">
                <include name="**/*.jar"/>
                <include name="**/*.pom"/>
            </fileset>
        </copy>
    </target>

    <target name="createManifest" depends="copy-dependencies">
        <!-- locate the fetched OSGi bundle jar and read its identity straight from the jar -->
        <path id="path.osgijar">
            <fileset dir="${temp}/osgi" casesensitive="yes">
                <include name="*.jar"/>
            </fileset>
        </path>
        <property name="osgijar" refid="path.osgijar"/>

        <loadmf jar="${osgijar}" prefix="manifest."/>
        <trim text="${manifest.Bundle-SymbolicName}" property="symbolicName"/>
        <trim text="${manifest.Bundle-Version}" property="symbolicVersion"/>

        <!-- driver class from the bundle's service file (fallback to the passed driverClass) -->
        <unzip src="${osgijar}" dest="${temp}/svc">
            <patternset><include name="META-INF/services/java.sql.Driver"/></patternset>
        </unzip>
        <loadfile property="className1" srcFile="${temp}/svc/META-INF/services/java.sql.Driver"/>
        <first text="${className1}" property="className2" default="${driverClass}"/>
        <trim text="${className2}" property="className"/>

        <unwrap text="${connstr}" property="_connstr"/>

        <!-- jars/ : the OSGi bundle, for OSGi bundle loading on older / OSGi-only Lucee -->
        <mkdir dir="${dist}/extension/jars"/>
        <copy file="${osgijar}" tofile="${dist}/extension/jars/${symbolicName}-${symbolicVersion}.jar"/>

        <tstamp>
            <format property="NOW" pattern="yyyy-MM-dd HH:mm:ss" />
        </tstamp>

        <!-- jdbc entry carries BOTH: 'maven' (used on Lucee 7.1.0.187+) and bundleName/bundleVersion
             (OSGi fallback on older Lucee). Both drivers are embedded so either path works offline. -->
        <echo file="${dist}/extension/META-INF/MANIFEST.MF">Manifest-Version: 1.0
Built-Date: ${NOW}
version: "${projectVersion}"
id: "${id}"
name: "${label}"
description: "${description}"
category: "Datasource"
lucee-core-version: "${luceeCoreVersion}"
release-type: ${releaseType}
start-bundles: false
jdbc: "[{'label':'${label}','id':'${jdbcid}','connectionString':'${_connstr}','class':'${className}','bundleName':'${symbolicName}','bundleVersion':'${symbolicVersion}','maven':'${mvnGroupId}:${mvnArtifactId}:${mvnVersion}'}]"
</echo>
    </target>

    <target name="dist" depends="createManifest" description="generate the distribution">
        <path id="path.cfc">
            <fileset dir="." casesensitive="yes">
                <include name="*.cfc"/>
            </fileset>
        </path>
        <property name="cfc" refid="path.cfc"/>
        <getNameFrom path="${cfc}" property="cfcName"/>

        <copy file="${cfc}" tofile="${dist}/extension/context/admin/dbdriver/${cfcName}"/>
        <loadfile property="content1" srcFile="${dist}/extension/context/admin/dbdriver/${cfcName}" />
        <replace haystack="${content1}" needle="{class-name}" repl="${className}" property="content2"/>
        <replace haystack="${content2}" needle="{bundle-name}" repl="${symbolicName}" property="content3"/>
        <replace haystack="${content3}" needle="{id}" repl="${jdbcid}" property="content4"/>
        <replace haystack="${content4}" needle="{label}" repl="${label}" property="content5"/>
        <replace haystack="${content5}" needle="{description}" repl="${description}" property="content6"/>
        <replace haystack="${content6}" needle="{connstr}" repl="${_connstr}" property="content7"/>
        <!-- this.maven carries groupId:artifactId only (no version); the version comes from the jdbc registration -->
        <replace haystack="${content7}" needle="{maven}" repl="${mvnGroupId}:${mvnArtifactId}" property="content8"/>
        <echo message="${content8}" file="${dist}/extension/context/admin/dbdriver/${cfcName}"/>

        <copy todir="${dist}/extension/META-INF">
            <fileset dir=".">
                <include name="logo.png"/>
            </fileset>
        </copy>

        <!-- full: embeds both the maven driver (maven/) and the OSGi bundle (jars/) -->
        <zip destfile="${dist}/${filename}-${projectVersion}.lex">
            <zipfileset dir="${dist}/extension"/>
        </zip>

        <!-- lite: no embedded driver; resolves maven from Central and the OSGi bundle from the update provider -->
        <zip destfile="${dist}/${filename}-${projectVersion}.lite.lex">
            <zipfileset dir="${dist}/extension">
                <exclude name="maven/**"/>
                <exclude name="jars/**"/>
            </zipfileset>
        </zip>
    </target>

    <target name="clean" depends="dist" description="clean up">
        <delete dir="${temp}"/>
    </target>
</project>
